# ─── Supabase ───────────────────────────────────────────────────────
# Copia este archivo como .env y rellena tus valores de https://supabase.com

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# ─── Groq (GRATIS) ────────────────────────────────────────────────
# Obtén tu clave gratuita en https://console.groq.com
# Groq usa Whisper large-v3-turbo: transcripción en segundos, 0 coste.
VITE_GROQ_API_KEY=gsk_TU_CLAVE_GROQ_AQUI
